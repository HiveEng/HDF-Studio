{
  "name": "hdf-studio",
  "version": "0.1.0",
  "description": "HDS (Hive Document Studio): open-source PDF reader and editor",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "predev": "node scripts/ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ocr-assets.mjs",
    "build": "tsc -p . && vite build",
    "tauri": "tauri",
    "hds": "tsx cli/hdfstudio.ts",
    "hdfstudio": "tsx cli/hdfstudio.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "dictionary-en": "^4.0.0",
    "fflate": "^0.8.3",
    "lucide": "^1.80.0",
    "mupdf": "^1.28.6",
    "node-forge": "^1.4.4",
    "nspell": "^2.1.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.10",
    "@types/node-forge": "^1.3.14",
    "@types/nspell": "^2.1.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module",
  "bin": {
    "hds": "cli/hdfstudio.ts",
    "hdfstudio": "cli/hdfstudio.ts"
  }
