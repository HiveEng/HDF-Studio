{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire",
  "version": "0.1.0",
  "identifier": "app.quire.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Quire", "width": 1280, "height": 860, "minWidth": 640, "minHeight": 400, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["pdf"], "name": "PDF Document", "description": "PDF Document", "role": "Editor", "mimeType": "application/pdf" }],
    "license": "AGPL-3.0-or-later",
    "shortDescription": "Open-source PDF reader and editor",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
